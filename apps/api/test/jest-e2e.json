{
  "moduleFileExtensions": ["js", "mjs", "cjs", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": {
          "esModuleInterop": true,
          "module": "CommonJS",
          "moduleResolution": "Node",
          "experimentalDecorators": true,
          "emitDecoratorMetadata": true,
          "strict": true
        }
      }
    ],
    "^.+\\.mjs$": [
      "ts-jest",
      {
        "tsconfig": {
          "esModuleInterop": true,
          "module": "CommonJS",
          "moduleResolution": "Node"
        }
      }
    ]
  },
  "transformIgnorePatterns": ["/node_modules/(?!@anthropic-ai/claude-agent-sdk)"],
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/setup-env.js"],
  "moduleNameMapper": {
    "^@anthropic-ai/claude-agent-sdk$": "<rootDir>/__mocks__/claude-agent-sdk.js",
    "^@/(.*)$": "<rootDir>/../src/$1"
  }
}
