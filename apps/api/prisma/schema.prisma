generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String?
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  meetings  Meeting[]
}

model Meeting {
  id           String         @id @default(cuid())
  title        String
  date         DateTime
  participants String[]
  ownerId      String
  owner        User           @relation(fields: [ownerId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  files        MeetingFile[]
  summary      MeetingSummary? @relation("MeetingSummary")
  tasks        Task[]          @relation("MeetingTasks")
}

enum TranscriptionStatus {
  PENDING
  IN_PROGRESS
  DONE
  FAILED
  SKIPPED
}

enum SummaryStatus {
  PENDING
  IN_PROGRESS
  DONE
  FAILED
}

model MeetingFile {
  id                  String              @id @default(cuid())
  meetingId           String
  meeting             Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  originalName        String
  mimeType            String
  size                Int
  filePath            String
  uploadedAt          DateTime            @default(now())
  transcriptionStatus TranscriptionStatus @default(SKIPPED)
  transcript          String?
  transcriptionError  String?
}

model MeetingSummary {
  id          String        @id @default(uuid())
  meetingId   String        @unique
  meeting     Meeting       @relation("MeetingSummary", fields: [meetingId], references: [id], onDelete: Cascade)
  summary     String?
  actionItems Json?
  decisions   Json?
  status      SummaryStatus @default(PENDING)
  error       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([meetingId])
}

enum TaskStatus {
  OPEN
  DONE
}

model Task {
  id              String    @id @default(uuid())
  title           String
  sourceMeetingId String
  sourceMeeting   Meeting   @relation("MeetingTasks", fields: [sourceMeetingId], references: [id], onDelete: Cascade)
  status          TaskStatus @default(OPEN)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([sourceMeetingId, title])
  @@index([sourceMeetingId])
}
